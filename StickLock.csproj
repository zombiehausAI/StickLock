<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StickLock</RootNamespace>
    <ApplicationIcon>wwwroot\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StickLock.Tests\**;artifacts\**;installer\**" />
    <Content Remove="StickLock.Tests\**;artifacts\**;installer\**" />
    <EmbeddedResource Remove="StickLock.Tests\**;artifacts\**;installer\**" />
    <None Remove="StickLock.Tests\**;artifacts\**;installer\**" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.120" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

</Project>
