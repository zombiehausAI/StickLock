@page "/"
@inject IAppConfigService ConfigService
@inject IDirectInputService DirectInputService
@inject IActionMapsXmlService XmlService
@inject IStarCitizenDetector GameDetector
@inject IActivityLogService LogService
@inject IFileDialogService FileDialog
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IBrowserService BrowserService

<div class="d-flex flex-column gap-3">
    <!-- Flight Controller Alignment Alert Banner -->
    @if (_alignmentCheck.IsMisaligned || _status == SyncStatus.NeedsSync) {
        <MudPaper Elevation="4" Class="pa-4" Style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.16) 0%, rgba(245, 158, 11, 0.12) 100%); border: 1.5px solid #EF4444; border-radius: 8px; box-shadow: 0 0 20px rgba(239, 68, 68, 0.25);">
            <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-4">
                <div class="d-flex align-start gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Error" Size="Size.Large" Class="mt-1" />
                    <div>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.subtitle1" Class="mfd-title" Style="color: #EF4444; font-weight: 800;">
                                FLIGHT CONTROLLER MISALIGNMENT DETECTED
                            </MudText>
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                                Binds Inverted
                            </MudChip>
                            @if (_alignmentCheck.IsGameRunning) {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">
                                    Star Citizen Active
                                </MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.body2" Class="mt-1" Style="color: #E2E8F0;">
                            Windows DirectInput slot enumeration does not match Star Citizen's <span class="mfd-code" style="color: #00E5FF;">actionmaps.xml</span>.
                        </MudText>

                        @if (_alignmentCheck.Mismatches.Any(m => m.IsFlipped)) {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var m in _alignmentCheck.Mismatches.Where(m => m.IsFlipped)) {
                                    <div class="pa-1 px-2 rounded d-flex align-center gap-2" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(239, 68, 68, 0.45); font-size: 0.8rem;">
                                        <span style="color: #F1F5F9; font-weight: 600;">@m.DeviceName:</span>
                                        <span class="mfd-code" style="color: #94A3B8;">XML:</span>
                                        <span class="mfd-code font-weight-bold" style="color: #FFAB00;">js@(m.XmlInstance)</span>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: #EF4444;" />
                                        <span class="mfd-code" style="color: #94A3B8;">Windows:</span>
                                        <span class="mfd-code font-weight-bold" style="color: #EF4444;">js@(m.LiveWindowsSlot)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex flex-column align-end gap-2" style="min-width: 240px;">
                    @if (!_alignmentCheck.IsGameRunning || ConfigService.Config.AllowSyncWhileGameRunning) {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Build"
                                   Disabled="@_isSyncing"
                                   OnClick="@(() => FixAndSyncSticksAsync(force: _alignmentCheck.IsGameRunning))"
                                   Class="mfd-title"
                                   Style="font-weight: 800; color: #FFFFFF; background-color: #DC2626; width: 100%;">
                            @if (_isSyncing) {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>FIXING...</span>
                            } else {
                                <span>FIX &amp; SYNC MAPPINGS</span>
                            }
                        </MudButton>
                    } else {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FlashOn"
                                   Disabled="@_isSyncing"
                                   OnClick="@(() => FixAndSyncSticksAsync(force: true))"
                                   Class="mfd-title"
                                   Style="font-weight: 800; color: #0B0F19; width: 100%;">
                            FORCE SYNC &amp; DEPLOY
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyConsoleCommandAsync"
                                   Style="width: 100%;">
                            Copy In-Game Cmd
                        </MudButton>
                    }
                </div>
            </div>
        </MudPaper>
    } else if (_lastFixedBackupPath != null) {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="mfd-card" Style="background-color: rgba(16, 185, 129, 0.16); border: 1px solid #10B981;">
            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <span style="color: #10B981; font-weight: 700;">
                    Mappings aligned &amp; backed up (<span class="mfd-code" style="color: #00E5FF;">@Path.GetFileName(_lastFixedBackupPath)</span>)
                </span>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.History" OnClick="RestoreBackupAsync">
                    Undo / Restore
                </MudButton>
            </div>
        </MudAlert>
    } else if (_status == SyncStatus.Unknown && _alignmentCheck.ExistingXmlDevices.Count >= 2 && ConfigService.Config.CanonicalSticks.Count == 0) {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mfd-card">
            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div>
                    <span class="font-weight-bold" style="color: #38BDF8;">DETECTED STAR CITIZEN JOYSTICKS: </span>
                    <span class="mfd-code" style="color: #CBD5E1;">
                        @string.Join(", ", _alignmentCheck.ExistingXmlDevices.Select(d => $"js{d.Instance} ({d.ProductName})"))
                    </span>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                           OnClick="AutoLockFromStarCitizenXmlAsync"
                           Style="color: #0B0F19; font-weight: 700;">
                    Auto-Lock from XML
                </MudButton>
            </div>
        </MudAlert>
    }

    <!-- Compact Star Citizen Root & Multi-Install Bar -->
    <MudPaper Class="mfd-card pa-3">
        <div class="d-flex flex-column gap-3">
            <!-- Row 1: Star Citizen Folder Input & Browse Actions -->
            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="flex-grow-1" style="min-width: 300px;">
                    <MudTextField Value="@GetDisplayedScFolder()"
                                  ValueChanged="@((string val) => OnScRootFolderInputChangedAsync(val))"
                                  Label="Star Citizen Installation Folder (Root containing LIVE, PTU, EPTU, TECH-PREVIEW)"
                                  Placeholder="e.g. C:\Program Files\Roberts Space Industries\StarCitizen"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.FolderSpecial"
                                  AdornmentColor="Color.Primary"
                                  Class="mfd-code" />
                </div>

                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="BrowseGameFolderAsync"
                               Class="mfd-title"
                               Style="color: #0B0F19; font-weight: 700;">
                        Set SC Folder
                    </MudButton>
                    <MudTooltip Text="Auto-detect Star Citizen installation folder across drives">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.TravelExplore"
                                   OnClick="AutoDetectScFolderAsync"
                                   Class="mfd-title">
                            Auto-Detect
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Select a custom actionmaps.xml file directly">
                        <MudIconButton Icon="@Icons.Material.Filled.InsertDriveFile"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="BrowseXmlFileAsync" />
                    </MudTooltip>
                </div>
            </div>

            <MudDivider Style="border-color: rgba(0, 229, 255, 0.1);" />

            <!-- Row 2: Detected Environments Pills & Multi-Install Sync -->
            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex flex-wrap align-center gap-2">
                    <span class="mfd-title mr-1" style="color: #94A3B8; font-size: 0.75rem;">INSTALLS:</span>
                    @foreach (var install in _detectedInstalls) {
                        var isSelected = ConfigService.Config.SelectedEnvironment == install.Environment;
                        var pillClass = $"env-pill {(isSelected ? "active" : "")} {(!install.IsDirectoryPresent ? "missing" : "")}";
                        var dotClass = install.HasActionMapsXml ? "status-dot detected" : (install.IsDirectoryPresent ? "status-dot folder-only" : "status-dot none");
                        var tooltip = install.HasActionMapsXml
                            ? $"{install.ChannelName}: actionmaps.xml detected ({install.ActionMapsPath})"
                            : (install.IsDirectoryPresent ? $"{install.ChannelName}: Folder found, no actionmaps.xml yet" : $"{install.ChannelName}: Not installed");

                        <MudTooltip Text="@tooltip">
                            <div class="@pillClass" @onclick="@(() => OnEnvironmentSelected(install.Environment))">
                                <span class="@dotClass"></span>
                                <span>@install.ChannelName</span>
                            </div>
                        </MudTooltip>
                    }
                </div>

                <div class="d-flex align-center gap-3">
                    <MudSwitch Value="ConfigService.Config.SyncAllDetectedInstalls"
                               ValueChanged="@((bool val) => OnSyncAllInstallsChanged(val))"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Label="Sync All Detected Installs" />

                    @if (_detectedInstalls.Count(i => i.IsDirectoryPresent) > 1) {
                        <MudTooltip Text="Copy & align active mappings across all detected installs (LIVE, PTU, EPTU, TECH-PREVIEW)">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.SyncAlt"
                                       OnClick="PropagateAcrossAllInstallsAsync"
                                       Class="mfd-title">
                                Propagate to All
                            </MudButton>
                        </MudTooltip>
                    }
                </div>
            </div>
        </div>
    </MudPaper>

    <!-- Focused MFD Workspace Tabs -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mfd-card" TabPanelsClass="pa-3">
        <!-- TAB 1: CONTROLLERS & SLOTS -->
        <MudTabPanel Text="CONTROLLERS & SLOTS" Icon="@Icons.Material.Filled.SportsEsports">
            <MudGrid Spacing="3">
                <!-- Left: Live DirectInput Enumeration -->
                <MudItem xs="12" lg="6">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="mfd-title" Style="color: #00E5FF;">LIVE WINDOWS DIRECTINPUT</MudText>
                        </div>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_isRefreshingDevices"
                                   OnClick="RefreshDevicesAsync"
                                   Class="mfd-title">
                            Refresh
                        </MudButton>
                    </div>

                    @if (_liveDevices.Count == 0) {
                        <div class="pa-6 text-center rounded" style="background: rgba(15, 23, 42, 0.5); border: 1px dashed rgba(148, 163, 184, 0.2);">
                            <MudIcon Icon="@Icons.Material.Filled.UsbOff" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                            <MudText Typo="Typo.body2" Style="color: #94A3B8;">No Flight Controllers Detected</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748B;">Connect your sticks or throttle via USB to lock slot order.</MudText>
                        </div>
                    } else {
                        <MudTable Items="_liveDevices" Dense="true" Hover="true" Elevation="0" Class="transparent">
                            <HeaderContent>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">SLOT</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">CONTROLLER</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700; text-align: right;">LOCK SLOT</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                                        @context.SlotName
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: #F8FAFC;">@context.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Class="mfd-code" Style="color: #64748B;">
                                        @(context.InstanceGuidString.Length > 8 ? context.InstanceGuidString.Substring(0, 8) + "..." : context.InstanceGuidString)
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @for (var slotNum = 1; slotNum <= 4; slotNum++) {
                                            var targetSlot = slotNum;
                                            <MudButton Size="Size.Small"
                                                       Variant="@(IsStickAssignedToSlot(context, targetSlot) ? Variant.Filled : Variant.Outlined)"
                                                       OnClick="@(() => AssignDeviceAsync(context, targetSlot, $"Stick {targetSlot} ({context.ProductName})"))">
                                                JS@(targetSlot)
                                            </MudButton>
                                        }
                                    </MudButtonGroup>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudItem>

                <!-- Right: Locked Canonical Assignment vs Active XML -->
                <MudItem xs="12" lg="6">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Class="mfd-title" Style="color: #00E5FF;">
                                LOCKED SLOTS (@ConfigService.Config.SelectedEnvironment)
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="Auto-detect and lock only joysticks with active bindings in Star Citizen XML">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                           OnClick="AutoLockFromStarCitizenXmlAsync"
                                           Class="mfd-title">
                                    Auto-Detect Sticks
                                </MudButton>
                            </MudTooltip>
                            <MudTooltip Text="@($"Copy in-game console resort command: '{_dynamicResortCommand}'")">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.ContentCopy"
                                           OnClick="CopyConsoleCommandAsync"
                                           Class="mfd-title">
                                    Copy Resort Cmd
                                </MudButton>
                            </MudTooltip>
                        </div>
                    </div>

                    @if (ConfigService.Config.CanonicalSticks.Count == 0) {
                        <div class="pa-6 text-center rounded" style="background: rgba(15, 23, 42, 0.5); border: 1px dashed rgba(148, 163, 184, 0.2);">
                            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                            <MudText Typo="Typo.body2" Style="color: #94A3B8;">No Canonical Slots Locked</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748B;">Click JS1..JS4 on the left or "Auto-Detect Sticks" above to lock your flight controllers.</MudText>
                        </div>
                    } else {
                        <MudTable Items="ConfigService.Config.CanonicalSticks" Dense="true" Hover="true" Elevation="0" Class="transparent">
                            <HeaderContent>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">LOCKED</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">DEVICE</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">WIN</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700;">XML</MudTh>
                                <MudTh Style="color: #00E5FF; font-weight: 700; text-align: right;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var liveSlot = GetLiveSlotForStick(context);
                                    var xmlInst = GetXmlInstanceForStick(context);
                                    var isAlignedWithXml = liveSlot > 0 && xmlInst > 0 && liveSlot == xmlInst;
                                }
                                <MudTd>
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">
                                        @context.SlotName
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: #F8FAFC;">@context.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #64748B;">@context.FriendlyRoleName</MudText>
                                </MudTd>
                                <MudTd>
                                    @if (liveSlot > 0) {
                                        <MudChip T="string" Color="@(isAlignedWithXml ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                            js@(liveSlot)
                                        </MudChip>
                                    } else {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                                            OFF
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    @if (xmlInst > 0) {
                                        <MudChip T="string" Color="@(isAlignedWithXml ? Color.Success : Color.Error)" Size="Size.Small" Variant="Variant.Outlined">
                                            js@(xmlInst)
                                        </MudChip>
                                    } else {
                                        <MudText Typo="Typo.caption" Style="color: #64748B;">—</MudText>
                                    }
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveCanonicalStickAsync(context.RoleSlot))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- TAB 2: PROFILES & MAPPINGS LIBRARY -->
        <MudTabPanel Text="@($"PROFILES & MAPPINGS ({_savedProfiles.Count})")" Icon="@Icons.Material.Filled.LibraryBooks">
            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mfd-title" Style="color: #00E5FF;">PERSISTENT MAPPINGS LIBRARY</MudText>
                    <MudText Typo="Typo.caption" Class="mfd-code" Style="color: #94A3B8;">
                        Stored in <span style="color: #FFAB00;">~/.sticklock/mappings/</span> — deploys across @(ConfigService.Config.SyncAllDetectedInstalls ? "all detected SC installs" : ConfigService.Config.SelectedEnvironment.ToString())
                    </MudText>
                </div>
                <div class="d-flex flex-wrap align-center gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.BookmarkAdd"
                               OnClick="OpenSaveProfileDialogAsync"
                               Class="mfd-title"
                               Style="color: #0B0F19; font-weight: 700;">
                        Save Active
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="CopyAllToStarCitizenAsync"
                               Class="mfd-title">
                        Deploy All to SC
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               OnClick="PullFromStarCitizenAsync"
                               Class="mfd-title">
                        Pull from SC
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ImportAndApplyProfileXmlAsync"
                               Class="mfd-title">
                        Import XML
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FileUpload"
                               OnClick="ExportProfileXmlAsync"
                               Class="mfd-title">
                        Export XML
                    </MudButton>
                    <MudTooltip Text="Open ~/.sticklock/mappings in Explorer">
                        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="OpenMappingsFolder" />
                    </MudTooltip>
                </div>
            </div>

            @if (_savedProfiles.Count == 0) {
                <div class="pa-6 text-center rounded" style="background: rgba(15, 23, 42, 0.5); border: 1px dashed rgba(148, 163, 184, 0.2);">
                    <MudIcon Icon="@Icons.Material.Filled.FolderZip" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                    <MudText Typo="Typo.body2" Style="color: #94A3B8;">No Saved Profiles Yet</MudText>
                    <MudText Typo="Typo.caption" Style="color: #64748B;">
                        Click "Save Active" to snapshot your current bindings, or "Pull from SC" to import your Star Citizen Control Profiles.
                    </MudText>
                </div>
            } else {
                <MudTable Items="_savedProfiles" Dense="true" Hover="true" Elevation="0" Class="transparent">
                    <HeaderContent>
                        <MudTh Style="color: #00E5FF; font-weight: 700;">PROFILE</MudTh>
                        <MudTh Style="color: #00E5FF; font-weight: 700;">DEVICES</MudTh>
                        <MudTh Style="color: #00E5FF; font-weight: 700;">BINDS</MudTh>
                        <MudTh Style="color: #00E5FF; font-weight: 700;">STATUS</MudTh>
                        <MudTh Style="color: #00E5FF; font-weight: 700; text-align: right;">ACTIONS</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="d-flex flex-column">
                                <span class="font-weight-bold" style="color: #F8FAFC;">@context.FileName</span>
                                <span class="mfd-code" style="font-size: 0.72rem; color: #64748B;">@context.LastModified.ToString("yyyy-MM-dd HH:mm") • @(context.FileSizeBytes / 1024) KB</span>
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex flex-wrap gap-1">
                                @if (context.DeviceNames.Count > 0) {
                                    @foreach (var dev in context.DeviceNames) {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="py-0 px-1" Style="font-size: 0.7rem; height: 20px;">
                                            @dev
                                        </MudChip>
                                    }
                                } else {
                                    <span class="mfd-code" style="color: #64748B;">@context.JoystickOptionsCount device(s)</span>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <span class="mfd-code" style="color: #CBD5E1;">@context.RebindCount</span>
                        </MudTd>
                        <MudTd>
                            @if (context.ExistsInStarCitizen) {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    Deployed
                                </MudChip>
                            } else {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                    Local Only
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <div class="d-flex align-center justify-end gap-1">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => ApplyProfileAsync(context.FileName))"
                                           Style="color: #0B0F19; font-weight: 700; font-size: 0.75rem;">
                                    Apply
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           OnClick="@(() => CopyProfileToStarCitizenAsync(context.FileName))"
                                           Style="font-size: 0.75rem;">
                                    Deploy
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteProfileAsync(context.FileName))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 3: SETTINGS & ACTIVITY LOG -->
        <MudTabPanel Text="SETTINGS & LOGS" Icon="@Icons.Material.Filled.Tune">
            <MudGrid Spacing="3">
                <!-- Left: Daemon & Sync Preferences -->
                <MudItem xs="12" lg="5">
                    <MudText Typo="Typo.subtitle2" Class="mfd-title mb-2" Style="color: #00E5FF;">DAEMON &amp; SYNC PREFERENCES</MudText>
                    <div class="d-flex flex-column gap-1 pa-3 rounded" style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(0, 229, 255, 0.1);">
                        <MudSwitch Value="ConfigService.Config.SyncAllDetectedInstalls"
                                   ValueChanged="@((bool val) => OnSyncAllInstallsChanged(val))"
                                   Color="Color.Primary"
                                   Label="Sync across all detected SC installs (LIVE, PTU, EPTU, TECH)" />
                        <MudSwitch Value="ConfigService.Config.AutoSyncOnUsbChange"
                                   ValueChanged="@((bool val) => OnAutoSyncChanged(val))"
                                   Color="Color.Primary"
                                   Label="Auto-Sync when USB controllers change" />
                        <MudSwitch Value="ConfigService.Config.AutoDeployToMappingsFolder"
                                   ValueChanged="@((bool val) => OnAutoDeployToMappingsFolderChanged(val))"
                                   Color="Color.Secondary"
                                   Label="Auto-Deploy layout_StickLock_Active.xml to Controls\Mappings" />
                        <MudSwitch Value="ConfigService.Config.AllowSyncWhileGameRunning"
                                   ValueChanged="@((bool val) => OnAllowSyncWhileGameRunningChanged(val))"
                                   Color="Color.Warning"
                                   Label="Allow Force Sync while Star Citizen is running" />
                        <MudSwitch Value="ConfigService.Config.StartMinimizedToTray"
                                   ValueChanged="@((bool val) => OnStartMinimizedChanged(val))"
                                   Color="Color.Primary"
                                   Label="Start minimized to Windows System Tray" />
                        <MudSwitch Value="ConfigService.Config.RunOnWindowsStartup"
                                   ValueChanged="@((bool val) => OnRunStartupChanged(val))"
                                   Color="Color.Primary"
                                   Label="Launch automatically on Windows Startup" />

                        <MudDivider Class="my-2" Style="border-color: rgba(0, 229, 255, 0.1);" />

                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Backup"
                                       OnClick="BackupCurrentSettingsAsync"
                                       Class="mfd-title"
                                       Style="color: #0B0F19; font-weight: 700;">
                                Backup Settings
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="ExportSettingsJsonAsync"
                                       Class="mfd-title">
                                Export JSON
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="ImportSettingsJsonAsync"
                                       Class="mfd-title">
                                Import JSON
                            </MudButton>
                        </div>
                    </div>
                </MudItem>

                <!-- Right: Activity & Backup Log -->
                <MudItem xs="12" lg="7">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Class="mfd-title" Style="color: #00E5FF;">ACTIVITY &amp; BACKUP LOG</MudText>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.History"
                                       OnClick="RestoreBackupAsync"
                                       Class="mfd-title">
                                Restore Latest XML Backup
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ClearAll"
                                       OnClick="ClearLog">
                                Clear
                            </MudButton>
                        </div>
                    </div>

                    <div style="height: 260px; overflow-y: auto; background: rgba(11, 15, 25, 0.9); border: 1px solid #1E293B; border-radius: 6px; padding: 10px;">
                        @if (LogService.Entries.Count == 0) {
                            <MudText Typo="Typo.caption" Class="mfd-code" Style="color: #64748B;">StickLock log ready. Monitoring USB activity and Star Citizen installs.</MudText>
                        } else {
                            @foreach (var entry in LogService.Entries) {
                                <div class="d-flex align-start mb-1" style="font-size: 0.8rem;">
                                    <span class="mfd-code mr-2" style="color: #64748B;">[@entry.TimeFormatted]</span>
                                    <MudChip T="string" Color="@GetLogLevelColor(entry.Level)" Size="Size.Small" Variant="Variant.Filled" Class="mr-2 py-0 px-1" Style="font-size: 0.65rem; height: 18px;">
                                        @entry.Level.ToUpperInvariant()
                                    </MudChip>
                                    <span style="color: #E2E8F0; flex-grow: 1;">@entry.Message</span>
                                    @if (!string.IsNullOrWhiteSpace(entry.Details)) {
                                        <span class="mfd-code ml-2" style="color: #94A3B8;">@entry.Details</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private IReadOnlyList<DirectInputDevice> _liveDevices = Array.Empty<DirectInputDevice>();
    private IReadOnlyList<XmlStickMapping> _xmlMappings = Array.Empty<XmlStickMapping>();
    private IReadOnlyList<SavedMappingProfile> _savedProfiles = Array.Empty<SavedMappingProfile>();
    private IReadOnlyList<DetectedScInstall> _detectedInstalls = Array.Empty<DetectedScInstall>();
    private MappingAlignmentCheck _alignmentCheck = new();
    private string? _lastFixedBackupPath = null;
    private SyncStatus _status = SyncStatus.Unknown;
    private string _dynamicResortCommand = "pp_resortdevices joystick 1 2";
    private bool _isSyncing = false;
    private bool _isRefreshingDevices = false;

    protected override async Task OnInitializedAsync() {
        DirectInputService.DevicesRefreshed += OnDevicesChanged;
        ConfigService.ConfigChanged += OnConfigChanged;
        LogService.EntryAdded += _ => InvokeAsync(StateHasChanged);

        _liveDevices = DirectInputService.CurrentDevices;
        _detectedInstalls = ConfigService.GetDetectedInstalls();
        await RefreshAlignmentCheckAsync();
        await ReloadXmlMappingsAsync();
        await ReloadSavedProfilesAsync();
    }

    private void OnDevicesChanged(IReadOnlyList<DirectInputDevice> devices) {
        _ = InvokeAsync(async () => {
            _liveDevices = devices;
            await RefreshAlignmentCheckAsync();
            StateHasChanged();
        });
    }

    private void OnConfigChanged() {
        _ = InvokeAsync(async () => {
            _detectedInstalls = ConfigService.GetDetectedInstalls();
            await RefreshAlignmentCheckAsync();
            await ReloadXmlMappingsAsync();
            await ReloadSavedProfilesAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAlignmentCheckAsync() {
        try {
            _alignmentCheck = await XmlService.CheckAlignmentAsync();
            _status = _alignmentCheck.Status;
            _dynamicResortCommand = await XmlService.GetConsoleResortCommandAsync();
        } catch {
            _alignmentCheck = new MappingAlignmentCheck();
            _status = SyncStatus.Unknown;
            _dynamicResortCommand = "pp_resortdevices joystick 1 2";
        }
    }

    private async Task ReloadXmlMappingsAsync() {
        try {
            _xmlMappings = await XmlService.GetXmlMappingsAsync();
        } catch {
            _xmlMappings = Array.Empty<XmlStickMapping>();
        }
    }

    private async Task ReloadSavedProfilesAsync() {
        try {
            _savedProfiles = await XmlService.GetSavedMappingsAsync();
        } catch {
            _savedProfiles = Array.Empty<SavedMappingProfile>();
        }
    }

    private async Task FixAndSyncSticksAsync(bool force = false) {
        if (_isSyncing) {
            return;
        }

        if (GameDetector.IsGameRunning() && !force && !ConfigService.Config.AllowSyncWhileGameRunning) {
            Snackbar.Add("Star Citizen is currently running. Use Force Sync or the in-game console command.", Severity.Warning);
            return;
        }

        _isSyncing = true;
        StateHasChanged();
        try {
            var result = await XmlService.FixAndSyncAsync(force);
            if (result.Success) {
                _lastFixedBackupPath = result.BackupPath;
                Snackbar.Add(result.Message, Severity.Success);
            } else {
                Snackbar.Add(result.Message, Severity.Error);
            }
            await RefreshAlignmentCheckAsync();
            await ReloadXmlMappingsAsync();
            await ReloadSavedProfilesAsync();
        } finally {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task AutoLockFromStarCitizenXmlAsync() {
        _isSyncing = true;
        StateHasChanged();
        try {
            var result = await XmlService.AutoLockAndAlignFromXmlAsync();
            if (result.Success) {
                Snackbar.Add(result.Message, Severity.Success);
            } else {
                Snackbar.Add(result.Message, Severity.Warning);
            }
            await RefreshAlignmentCheckAsync();
            await ReloadXmlMappingsAsync();
        } finally {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task PropagateAcrossAllInstallsAsync() {
        _isSyncing = true;
        StateHasChanged();
        try {
            var result = await XmlService.PropagateActiveToDetectedInstallsAsync(force: ConfigService.Config.AllowSyncWhileGameRunning);
            if (result.Success) {
                Snackbar.Add(result.Message, Severity.Success);
                _detectedInstalls = ConfigService.GetDetectedInstalls();
            } else {
                Snackbar.Add(result.Message, Severity.Warning);
            }
            await RefreshAlignmentCheckAsync();
        } finally {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDevicesAsync() {
        if (_isRefreshingDevices) {
            return;
        }

        _isRefreshingDevices = true;
        StateHasChanged();
        try {
            _liveDevices = await DirectInputService.RefreshDevicesAsync();
            await RefreshAlignmentCheckAsync();
            LogService.LogInfo("DirectInput controllers refreshed.");
        } finally {
            _isRefreshingDevices = false;
            StateHasChanged();
        }
    }

    private async Task OnEnvironmentSelected(ScEnvironment env) {
        await ConfigService.SwitchEnvironmentAsync(env);
        _detectedInstalls = ConfigService.GetDetectedInstalls();
        await ReloadXmlMappingsAsync();
        await RefreshAlignmentCheckAsync();
        Snackbar.Add($"Switched active view to {env}.", Severity.Info);
    }

    private string GetDisplayedScFolder() {
        return !string.IsNullOrWhiteSpace(ConfigService.Config.StarCitizenRootPath)
            ? ConfigService.Config.StarCitizenRootPath
            : ConfigService.Config.StarCitizenPath;
    }

    private async Task OnScRootFolderInputChangedAsync(string val) {
        if (string.IsNullOrWhiteSpace(val)) {
            return;
        }
        if (val.EndsWith(".xml", StringComparison.OrdinalIgnoreCase)) {
            await ConfigService.SetStarCitizenPathAsync(val);
        } else {
            await ConfigService.SetStarCitizenRootFolderAsync(val);
        }
        _detectedInstalls = ConfigService.GetDetectedInstalls();
        await ReloadXmlMappingsAsync();
        await RefreshAlignmentCheckAsync();
    }

    private async Task BrowseXmlFileAsync() {
        var initialDir = !string.IsNullOrWhiteSpace(ConfigService.Config.StarCitizenPath)
            ? Path.GetDirectoryName(ConfigService.Config.StarCitizenPath)
            : null;

        var selected = await FileDialog.PickActionMapsXmlFileAsync(initialDir);
        if (!string.IsNullOrWhiteSpace(selected)) {
            await ConfigService.SetStarCitizenPathAsync(selected);
            _detectedInstalls = ConfigService.GetDetectedInstalls();
            await ReloadXmlMappingsAsync();
            Snackbar.Add("Selected actionmaps.xml path updated.", Severity.Success);
        }
    }

    private async Task BrowseGameFolderAsync() {
        var selected = await FileDialog.PickStarCitizenFolderAsync();
        if (!string.IsNullOrWhiteSpace(selected)) {
            await ConfigService.SetStarCitizenRootFolderAsync(selected);
            _detectedInstalls = ConfigService.GetDetectedInstalls();
            await ReloadXmlMappingsAsync();
            await RefreshAlignmentCheckAsync();

            var foundChannels = _detectedInstalls.Where(i => i.IsDirectoryPresent).Select(i => i.ChannelName).ToList();
            var xmlCount = _detectedInstalls.Count(i => i.HasActionMapsXml);
            if (foundChannels.Count > 0) {
                LogService.LogSuccess($"Star Citizen folder set. Detected: {string.Join(", ", foundChannels)} ({xmlCount} with actionmaps.xml).");
                Snackbar.Add($"Detected { string.Join(", ", foundChannels) } ({xmlCount} XML found).", Severity.Success);
            } else {
                Snackbar.Add($"Star Citizen folder set to {selected}", Severity.Info);
            }
        }
    }

    private async Task AutoDetectScFolderAsync() {
        if (ConfigService.TryAutoDetectStarCitizenRoot(out var root)) {
            await ConfigService.SetStarCitizenRootFolderAsync(root);
            _detectedInstalls = ConfigService.GetDetectedInstalls();
            await ReloadXmlMappingsAsync();
            await RefreshAlignmentCheckAsync();
            var found = _detectedInstalls.Where(i => i.IsDirectoryPresent).Select(i => i.ChannelName).ToList();
            Snackbar.Add($"Auto-detected Star Citizen at {root} ({string.Join(", ", found)})", Severity.Success);
        } else {
            Snackbar.Add("Could not auto-detect Star Citizen in standard drive locations. Use 'Set SC Folder' to select it.", Severity.Warning);
        }
    }

    private async Task OnSyncAllInstallsChanged(bool val) {
        await ConfigService.SetSyncAllDetectedInstallsAsync(val);
        Snackbar.Add($"Sync across all detected SC installs is now {(val ? "ENABLED" : "DISABLED")}.", Severity.Info);
    }

    private async Task OnAutoSyncChanged(bool val) {
        await ConfigService.SetAutoSyncAsync(val);
        Snackbar.Add($"Auto-Sync on USB change is now {(val ? "ENABLED" : "DISABLED")}.", Severity.Info);
    }

    private async Task OnStartMinimizedChanged(bool val) {
        await ConfigService.SetStartMinimizedAsync(val);
        Snackbar.Add($"Start minimized to tray is now {(val ? "ENABLED" : "DISABLED")}.", Severity.Info);
    }

    private async Task OnRunStartupChanged(bool val) {
        await ConfigService.SetRunOnStartupAsync(val);
        Snackbar.Add($"Launch on Windows startup is now {(val ? "ENABLED" : "DISABLED")}.", Severity.Info);
    }

    private async Task OnAllowSyncWhileGameRunningChanged(bool val) {
        await ConfigService.SetAllowSyncWhileGameRunningAsync(val);
        await RefreshAlignmentCheckAsync();
        Snackbar.Add($"Sync while Star Citizen is running is now {(val ? "ENABLED (Force Sync allowed)" : "DISABLED (Safe Mode)")}.", Severity.Info);
    }

    private async Task OnAutoDeployToMappingsFolderChanged(bool val) {
        await ConfigService.SetAutoDeployToMappingsFolderAsync(val);
        Snackbar.Add($"Auto-deploy to in-game Controls\\Mappings is now {(val ? "ENABLED" : "DISABLED")}.", Severity.Info);
    }

    private async Task AssignDeviceAsync(DirectInputDevice device, int slot, string roleName) {
        await ConfigService.SetCanonicalStickAsync(slot, device, roleName);
        LogService.LogSuccess($"Assigned {device.ProductName} as locked js{slot} ({roleName}).");
        Snackbar.Add($"Locked {device.ProductName} as js{slot}.", Severity.Success);
        await ReloadXmlMappingsAsync();
    }

    private async Task RemoveCanonicalStickAsync(int slot) {
        await ConfigService.RemoveCanonicalStickAsync(slot);
        LogService.LogInfo($"Unlocked canonical stick js{slot}.");
        Snackbar.Add($"Unlocked stick js{slot}.", Severity.Info);
        await ReloadXmlMappingsAsync();
    }

    private bool IsStickAssignedToSlot(DirectInputDevice device, int slot) {
        return ConfigService.Config.CanonicalSticks.Any(s =>
            s.RoleSlot == slot &&
            ((device.InstanceGuid != Guid.Empty && s.InstanceGuid == device.InstanceGuid) ||
             (device.ProductGuid != Guid.Empty && s.ProductGuid == device.ProductGuid)));
    }

    private int GetLiveSlotForStick(CanonicalStick stick) {
        var dev = _liveDevices.FirstOrDefault(d =>
            (stick.InstanceGuid != Guid.Empty && d.InstanceGuid == stick.InstanceGuid) ||
            (stick.ProductGuid != Guid.Empty && d.ProductGuid == stick.ProductGuid) ||
            (!string.IsNullOrWhiteSpace(stick.ProductName) && string.Equals(d.ProductName, stick.ProductName, StringComparison.OrdinalIgnoreCase)));
        return dev?.SlotIndex ?? 0;
    }

    private int GetXmlInstanceForStick(CanonicalStick stick) {
        var mapping = _xmlMappings.FirstOrDefault(x =>
            (stick.InstanceGuid != Guid.Empty && x.ExtractedGuid == stick.InstanceGuid) ||
            (stick.ProductGuid != Guid.Empty && x.ExtractedGuid == stick.ProductGuid) ||
            (!string.IsNullOrWhiteSpace(stick.ProductName) && string.Equals(x.ProductName, stick.ProductName, StringComparison.OrdinalIgnoreCase)));

        if (mapping != null) {
            return mapping.Instance;
        }

        var fallback = _xmlMappings.FirstOrDefault(x => x.Instance == stick.RoleSlot);
        return fallback?.Instance ?? 0;
    }

    private async Task CopyConsoleCommandAsync() {
        var cmd = await XmlService.GetConsoleResortCommandAsync();
        var tcs = new TaskCompletionSource();
        var thread = new Thread(() => {
            try {
                Clipboard.SetText(cmd);
            } catch { }
            tcs.TrySetResult();
        });
        thread.SetApartmentState(ApartmentState.STA);
        thread.Start();
        await tcs.Task;
        Snackbar.Add($"Copied '{cmd}' to clipboard!", Severity.Success);
    }

    private async Task RestoreBackupAsync() {
        var result = await XmlService.RestoreLatestBackupAsync();
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadXmlMappingsAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Warning);
        }
    }

    private async Task OpenSaveProfileDialogAsync() {
        var options = new DialogOptions {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<SaveProfileDialog>("Save Active Mappings as Profile", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) {
            await ReloadSavedProfilesAsync();
            await ReloadXmlMappingsAsync();
        }
    }

    private async Task CopyProfileToStarCitizenAsync(string fileName) {
        var result = await XmlService.CopyProfileToStarCitizenAsync(fileName);
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task CopyAllToStarCitizenAsync() {
        var result = await XmlService.CopyAllProfilesToStarCitizenAsync();
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Warning);
        }
    }

    private async Task PullFromStarCitizenAsync() {
        var result = await XmlService.PullProfilesFromStarCitizenAsync();
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Info);
        }
    }

    private async Task ApplyProfileAsync(string fileName) {
        if (GameDetector.IsGameRunning()) {
            Snackbar.Add("Star Citizen is active. Please close the game before applying profiles.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Apply Saved Profile?",
            $"Apply '{fileName}' to your active Star Citizen actionmaps.xml?\n\nStickLock will automatically back up current settings and align physical joystick slots.",
            yesText: "Apply & Align",
            cancelText: "Cancel");

        if (confirmed != true) {
            return;
        }

        var result = await XmlService.ApplySavedProfileToActiveAsync(fileName);
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadXmlMappingsAsync();
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task DeleteProfileAsync(string fileName) {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Profile?",
            $"Are you sure you want to delete '{fileName}' from your .sticklock library?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) {
            return;
        }

        var deleted = await XmlService.DeleteSavedProfileAsync(fileName);
        if (deleted) {
            Snackbar.Add($"Deleted '{fileName}'", Severity.Info);
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add($"Could not delete '{fileName}'", Severity.Warning);
        }
    }

    private void OpenMappingsFolder() {
        BrowserService.OpenFolder(ConfigService.MappingsDirectory);
    }

    private async Task ExportProfileXmlAsync() {
        var activePath = ConfigService.Config.StarCitizenPath;
        if (string.IsNullOrWhiteSpace(activePath) || !File.Exists(activePath)) {
            Snackbar.Add("Active actionmaps.xml not found. Please verify the game path.", Severity.Warning);
            return;
        }

        var defaultDir = Directory.Exists(ConfigService.MappingsDirectory) ? ConfigService.MappingsDirectory : GetDefaultMappingsDir();
        var defaultFileName = $"layout_StickLock_{DateTime.Now:yyyyMMdd_HHmmss}.xml";

        var savePath = await FileDialog.SaveActionMapsXmlFileAsync(defaultFileName, defaultDir);
        if (string.IsNullOrWhiteSpace(savePath)) {
            return;
        }

        var result = await XmlService.ExportActiveXmlAsync(savePath);
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadSavedProfilesAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task ImportAndApplyProfileXmlAsync() {
        if (GameDetector.IsGameRunning()) {
            Snackbar.Add("Star Citizen is currently active. Please exit the game before importing profiles.", Severity.Warning);
            return;
        }

        var defaultDir = Directory.Exists(ConfigService.MappingsDirectory) ? ConfigService.MappingsDirectory : GetDefaultMappingsDir();
        var importPath = await FileDialog.PickXmlFileToImportAsync(defaultDir);
        if (string.IsNullOrWhiteSpace(importPath)) {
            return;
        }

        var summary = await XmlService.InspectXmlProfileAsync(importPath);
        if (!summary.IsValid) {
            Snackbar.Add($"Invalid profile XML: {summary.ErrorMessage}", Severity.Error);
            return;
        }

        var dialogMessage = $"File: {summary.FileName}\n" +
                            $"Devices: {summary.JoystickOptionsCount} ({string.Join(", ", summary.DeviceNames)})\n" +
                            $"Rebinds: {summary.RebindCount}\n\n" +
                            "Applying this profile will create a timestamped backup of your current active actionmaps.xml, " +
                            "apply the imported bindings, and automatically align the joystick slot order to match your current physical controllers.\n\n" +
                            "Proceed and apply to active game XML?";

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Apply Imported Control Profile?",
            dialogMessage,
            yesText: "Apply to Active XML",
            cancelText: "Cancel");

        if (confirmed != true) {
            return;
        }

        var result = await XmlService.ImportAndApplyXmlAsync(importPath);
        if (result.Success) {
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadXmlMappingsAsync();
        } else {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task ExportSettingsJsonAsync() {
        var defaultFileName = $"StickLock_Settings_{DateTime.Now:yyyyMMdd}.json";
        var savePath = await FileDialog.SaveJsonConfigFileAsync(defaultFileName);
        if (string.IsNullOrWhiteSpace(savePath)) {
            return;
        }

        try {
            await ConfigService.ExportConfigAsync(savePath);
            LogService.LogSuccess($"Exported StickLock settings to {Path.GetFileName(savePath)}");
            Snackbar.Add($"Settings exported to {Path.GetFileName(savePath)}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to export settings: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportSettingsJsonAsync() {
        var importPath = await FileDialog.PickJsonConfigFileAsync();
        if (string.IsNullOrWhiteSpace(importPath)) {
            return;
        }

        try {
            await ConfigService.ImportConfigAsync(importPath);
            LogService.LogSuccess($"Imported StickLock settings from {Path.GetFileName(importPath)}");
            Snackbar.Add("StickLock settings imported and applied.", Severity.Success);
            await ReloadXmlMappingsAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Failed to import settings: {ex.Message}", Severity.Error);
        }
    }

    private async Task BackupCurrentSettingsAsync() {
        try {
            var backupPath = await ConfigService.BackupCurrentSettingsAsync();
            var fileName = Path.GetFileName(backupPath);
            LogService.LogSuccess($"Settings backed up to .sticklock\\settings_backups\\{fileName}");
            Snackbar.Add($"Settings successfully backed up: {fileName}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to backup settings: {ex.Message}", Severity.Error);
        }
    }

    private string? GetDefaultMappingsDir() {
        var activePath = ConfigService.Config.StarCitizenPath;
        if (string.IsNullOrWhiteSpace(activePath)) {
            return null;
        }

        try {
            var profilesDir = Path.GetDirectoryName(activePath);
            var zeroDir = Path.GetDirectoryName(profilesDir);
            var clientZeroDir = Path.GetDirectoryName(zeroDir);
            if (!string.IsNullOrWhiteSpace(clientZeroDir)) {
                var mappingsDir = Path.Combine(clientZeroDir, "Controls", "Mappings");
                if (Directory.Exists(mappingsDir)) {
                    return mappingsDir;
                }
            }
            return profilesDir;
        } catch {
            return null;
        }
    }

    private void ClearLog() {
        LogService.Clear();
        StateHasChanged();
    }

    private Color GetLogLevelColor(string level) => level switch {
        "Success" => Color.Success,
        "Warning" => Color.Warning,
        "Error" => Color.Error,
        _ => Color.Info
    };

    public void Dispose() {
        DirectInputService.DevicesRefreshed -= OnDevicesChanged;
        ConfigService.ConfigChanged -= OnConfigChanged;
    }
}
