@using System.Reflection
@using StickLock.Models
@using StickLock.Services
@inject IBrowserService BrowserService
@inject IUpdateService UpdateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center">
                <img src="icon.png" alt="StickLock" style="width: 32px; height: 32px; border-radius: 6px; filter: drop-shadow(0 0 5px rgba(0, 229, 255, 0.35));" class="mr-2" />
                <MudText Typo="Typo.h6" Class="mfd-title glow-cyan" Style="color: #00E5FF;">STICKLOCK AVIONICS</MudText>
            </div>
            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">
                @AppVersion
            </MudChip>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 pt-2">
            <MudText Typo="Typo.body2" Style="color: #94A3B8;">
                High-performance Windows utility for automated Star Citizen DirectInput flight controller slot synchronization and actionmaps alignment.
            </MudText>

            <!-- Solo Developer Disclaimer -->
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mfd-card">
                <div class="font-weight-bold" Style="color: #38BDF8;">Solo Developer Side Project</div>
                <div style="font-size: 0.85rem; color: #CBD5E1; margin-top: 4px;">
                    StickLock is an independent side project created and maintained by a single developer. Due to full-time work and outside commitments, I'm unable to dedicate full-time hours to it—updates, bug fixes, and maintenance happen as personal time permits. Your patience and understanding are greatly appreciated!
                </div>
            </MudAlert>

            <!-- Proof of Concept Disclaimer -->
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mfd-card">
                <div class="font-weight-bold" Style="color: #FFAB00;">Proof of Concept & Community Testing</div>
                <div style="font-size: 0.85rem; color: #CBD5E1; margin-top: 4px;">
                    This application, scripts, and utilities represent a specialized utility created to overcome Windows DirectInput enumeration flips in Star Citizen. Hardware configurations, joystick firmware, USB hubs, and Windows driver versions can differ significantly—what works seamlessly in one test environment may require adjustments on yours. Community feedback, issue reports, and real-world testing are warmly welcomed!
                </div>
            </MudAlert>

            <!-- AI-Assisted Development Disclaimer -->
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mfd-card" Style="border-color: rgba(148, 163, 184, 0.3) !important;">
                <div class="font-weight-bold" Style="color: #E2E8F0;">AI-Assisted Development</div>
                <div style="font-size: 0.85rem; color: #CBD5E1; margin-top: 4px;">
                    This application, its scripts, and documentation were created with AI assistance. In the spirit of complete transparency: if you prefer not to use AI-assisted code, please feel free to pass on this project.
                </div>
            </MudAlert>

            <!-- Ko-fi Support Banner -->
            <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background: rgba(255, 94, 91, 0.08); border: 1px solid rgba(255, 94, 91, 0.3); border-radius: 6px;">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Coffee" Style="color: #FF5E5B;" Size="Size.Large" />
                    <div>
                        <div class="font-weight-bold" style="color: #FF5E5B; font-size: 0.95rem;">Support on Ko-fi</div>
                        <div style="font-size: 0.8rem; color: #94A3B8;">
                            If StickLock saved your keybinds and flight setup, consider buying me a coffee!
                        </div>
                    </div>
                </div>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Favorite"
                           OnClick="OpenKofi"
                           Class="mfd-title"
                           Style="background-color: #FF5E5B; color: white; font-weight: 700;">
                    Ko-fi.com/zombiehaus
                </MudButton>
            </MudPaper>

            <!-- Update Channel Selector -->
            <MudPaper Class="pa-3 d-flex align-center justify-space-between" Style="background: rgba(0, 229, 255, 0.05); border: 1px solid rgba(0, 229, 255, 0.2); border-radius: 6px;">
                <div class="d-flex flex-column" style="max-width: 58%;">
                    <div class="font-weight-bold" style="color: #00E5FF; font-size: 0.9rem;">Update Channel</div>
                    <div style="font-size: 0.8rem; color: #94A3B8;">
                        Select which release track you want to receive updates from:
                    </div>
                </div>
                <MudSelect T="string" Value="@_currentChannel" ValueChanged="OnChannelChangedAsync" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 175px;">
                    <MudSelectItem Value="@("Release")">Release (Stable - main)</MudSelectItem>
                    <MudSelectItem Value="@("Beta")">Beta (Development - dev)</MudSelectItem>
                    <MudSelectItem Value="@("Alpha")">Alpha (Feature Previews)</MudSelectItem>
                </MudSelect>
            </MudPaper>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.SystemUpdate"
                   Disabled="@_isCheckingUpdate"
                   OnClick="CheckForUpdatesAsync">
            @(_isCheckingUpdate ? "Checking..." : "Check for Updates")
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    private string AppVersion { get; set; } = "v1.0.0";
    private bool _isCheckingUpdate = false;
    private string _currentChannel = "Release";

    protected override void OnInitialized() {
        var version = System.Reflection.Assembly.GetExecutingAssembly()
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?
            .InformationalVersion;
        if (!string.IsNullOrWhiteSpace(version)) {
            int plusIndex = version.IndexOf('+');
            if (plusIndex > 0) {
                version = version.Substring(0, plusIndex);
            }
            AppVersion = "v" + version;
        }

        _currentChannel = UpdateService.CurrentChannel;
    }

    private async Task OnChannelChangedAsync(string newChannel) {
        if (_currentChannel == newChannel) {
            return;
        }
        _currentChannel = newChannel;
        await UpdateService.SetUpdateChannelAsync(newChannel);
        Snackbar.Add($"Switched update channel to {newChannel}.", Severity.Info);
        StateHasChanged();
    }

    private async Task CheckForUpdatesAsync() {
        _isCheckingUpdate = true;
        StateHasChanged();

        try {
            var info = await UpdateService.CheckForUpdateAsync(force: true);
            if (info.IsUpdateAvailable) {
                var parameters = new DialogParameters<UpdateDialog> {
                    { x => x.UpdateInfo, info }
                };
                var options = new DialogOptions {
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                };
                await DialogService.ShowAsync<UpdateDialog>("StickLock Update Available", parameters, options);
            } else if (!string.IsNullOrWhiteSpace(info.ErrorMessage)) {
                Snackbar.Add($"Update check failed: {info.ErrorMessage}", Severity.Warning);
            } else {
                Snackbar.Add($"StickLock is up to date (v{info.CurrentVersion}).", Severity.Success);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Error checking updates: {ex.Message}", Severity.Error);
        } finally {
            _isCheckingUpdate = false;
            StateHasChanged();
        }
    }

    private void OpenKofi() {
        BrowserService.OpenUrl("https://ko-fi.com/zombiehaus");
    }

    private void Close() {
        MudDialog?.Close(DialogResult.Ok(true));
    }
}
