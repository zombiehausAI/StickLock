@using StickLock.Models

<div class="schematic-container pa-4 rounded" style="background: radial-gradient(circle at 50% 30%, rgba(15, 23, 42, 0.95) 0%, rgba(7, 10, 19, 0.98) 100%); border: 1.5px solid rgba(0, 229, 255, 0.2); position: relative;">
    <!-- Schematic Header info -->
    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Class="mfd-title glow-cyan" Style="color: #00E5FF; font-weight: 700;">
                @Layout.Name.ToUpperInvariant()
            </MudText>
            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">
                @($"Slot js{StickSlot}")
            </MudChip>
        </div>

        <!-- Live Physical Input Indicator Banner -->
        @if (!string.IsNullOrWhiteSpace(ActivePhysicalInput)) {
            <div class="d-flex align-center gap-2 px-3 py-1 rounded" style="background: rgba(245, 158, 11, 0.2); border: 1px solid #F59E0B; animation: pulse-live 0.8s infinite;">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Style="color: #F59E0B;" Size="Size.Small" />
                <span class="mfd-code font-weight-bold" style="color: #FCD34D; font-size: 0.85rem;">
                    PHYSICAL INPUT DETECTED: @ActivePhysicalInput.ToUpperInvariant()
                </span>
            </div>
        }
    </div>

    <!-- Multi-Module View Selector Tabs (e.g. Stick vs SEM vs FSM-GA) -->
    @if (Layout.SubModules.Count > 0) {
        <div class="d-flex flex-wrap align-center gap-2 mb-3">
            <div class="module-tab-bar pa-1 rounded d-flex align-center gap-1">
                <button type="button"
                        class="module-tab-btn @(_selectedSubModuleIndex == 0 ? "active" : "")"
                        @onclick="() => SelectSubModule(0)">
                    <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small" Class="mr-1" />
                    Grip &amp; Base
                </button>
                @for (int i = 0; i < Layout.SubModules.Count; i++) {
                    var idx = i + 1;
                    var sub = Layout.SubModules[i];
                    <button type="button"
                            class="module-tab-btn @(_selectedSubModuleIndex == idx ? "active" : "")"
                            @onclick="() => SelectSubModule(idx)">
                        <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" Size="Size.Small" Class="mr-1" />
                        @sub.Name
                    </button>
                }
            </div>
        </div>
    }

    @{
        var activeLayout = GetActiveLayout();
    }

    <!-- High-Resolution Graphic Diagram with Interactive Hotspot Overlay -->
    <div class="diagram-viewport rounded" style="position: relative; width: 100%; max-width: 1000px; margin: 0 auto; background: #0B0F19; border: 1.5px solid rgba(0, 229, 255, 0.2); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);">
        @if (!string.IsNullOrWhiteSpace(activeLayout.ImageUrl)) {
            <img src="@activeLayout.ImageUrl"
                 alt="@activeLayout.Name"
                 style="width: 100%; height: auto; display: block; user-select: none; pointer-events: none;" />
        }

        <!-- Interactive Hotspot Overlays (Positioned directly over callout boxes) -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
            @foreach (var spot in activeLayout.Hotspots) {
                var boundItem = FindBoundItem(spot.InputCode);
                var isBound = boundItem != null;
                var isSelected = _selectedHotspotId == spot.Id;
                var isLiveActive = string.Equals(ActivePhysicalInput, spot.InputCode, StringComparison.OrdinalIgnoreCase);

                <div style="position: absolute; left: @(spot.X)%; top: @(spot.Y)%; transform: translate(-50%, -50%); z-index: 10; pointer-events: auto;">
                    <MudTooltip Text="@GetTooltipText(spot, boundItem)" Placement="Placement.Top">
                        <button class="callout-badge @(isBound ? "bound" : "unbound") @(isSelected ? "selected" : "") @(isLiveActive ? "live-active" : "")"
                                @onclick="() => OnBadgeClicked(spot, boundItem)">
                            <span class="badge-code">
                                @FormatDisplayButtonNumber(spot.InputCode)
                            </span>
                            @if (isBound && boundItem != null) {
                                <span class="badge-bound-name">
                                    @boundItem.DisplayAction
                                </span>
                            }
                        </button>
                    </MudTooltip>
                </div>
            }
        </div>
    </div>

    <!-- Active Control Inspector Bar (Instant Feedback on Click or Physical Press) -->
    <div class="mt-3 pa-3 rounded d-flex flex-wrap align-center justify-space-between gap-3"
         style="background: rgba(15, 23, 42, 0.85); border: 1.5px solid rgba(0, 229, 255, 0.25);">
        @if (_selectedHotspot != null) {
            var bound = FindBoundItem(_selectedHotspot.InputCode);
            <div class="d-flex align-center gap-3">
                <div class="hotspot-preview-badge">
                    <span class="mfd-code font-weight-bold" style="color: #FFD700; font-size: 0.95rem;">
                        @_selectedHotspot.InputCode.ToUpperInvariant()
                    </span>
                </div>
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle2" Class="mfd-title" Style="color: #00E5FF; font-weight: 700;">
                            @_selectedHotspot.Label
                        </MudText>
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Style="font-size: 0.65rem; height: 18px;">
                            @_selectedHotspot.ModuleName
                        </MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Style="color: #94A3B8;">
                        @if (bound != null) {
                            <span>Mapped to: <b style="color: #10B981;">@bound.DisplayCategory &gt; @bound.DisplayAction</b></span>
                        } else {
                            <span style="color: #64748B;">Not currently mapped in active actionmaps.xml</span>
                        }
                    </MudText>
                </div>
            </div>

            <div class="d-flex align-center gap-2">
                @if (bound != null) {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="() => ClearSelectedBindingAsync(bound)">
                        Clear
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="() => RebindSelectedAsync(_selectedHotspot, bound)"
                           Style="color: #0B0F19; font-weight: 700;">
                    @(bound != null ? "Rebind Action" : "Map Action")
                </MudButton>
            </div>
        } else {
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.body2" Style="color: #94A3B8;">
                    Click any button box above to inspect or rebind, or press any button on your physical flight controller to locate it in real time!
                </MudText>
            </div>
        }
    </div>
</div>

<style>
    .schematic-container {
        user-select: none;
    }
    .module-tab-bar {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(0, 229, 255, 0.25);
        display: inline-flex;
        border-radius: 6px;
    }
    .module-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 4px;
        color: #94A3B8;
        padding: 6px 14px;
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease-in-out;
    }
    .module-tab-btn:hover {
        color: #38BDF8;
        background: rgba(0, 229, 255, 0.08);
    }
    .module-tab-btn.active {
        background: #00E5FF;
        color: #0B0F19;
        font-weight: 800;
        box-shadow: 0 0 12px rgba(0, 229, 255, 0.5);
    }
    .callout-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        background: rgba(15, 23, 42, 0.92);
        border: 1.5px solid #00E5FF;
        border-radius: 6px;
        color: #E2E8F0;
        font-family: 'Consolas', monospace;
        font-size: 0.72rem;
        cursor: pointer;
        transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
        outline: none;
    }
    .callout-badge:hover {
        transform: scale(1.18);
        border-color: #38BDF8;
        box-shadow: 0 0 16px rgba(0, 229, 255, 0.85);
        z-index: 50;
    }
    .callout-badge.bound {
        border-color: #10B981;
        background: rgba(6, 78, 59, 0.88);
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }
    .callout-badge.bound:hover {
        border-color: #34D399;
        box-shadow: 0 0 18px rgba(16, 185, 129, 0.9);
    }
    .callout-badge.selected {
        border-color: #FFD700 !important;
        background: rgba(120, 53, 15, 0.95) !important;
        color: #FFF !important;
        box-shadow: 0 0 20px #FFD700, 0 0 40px rgba(255, 215, 0, 0.7) !important;
        transform: scale(1.22);
        z-index: 60;
        animation: pulse-gold 1.5s infinite;
    }
    .callout-badge.live-active {
        border-color: #F59E0B !important;
        background: #F59E0B !important;
        color: #000 !important;
        font-weight: 800 !important;
        box-shadow: 0 0 25px #F59E0B, 0 0 50px rgba(245, 158, 11, 0.95) !important;
        transform: scale(1.3) !important;
        z-index: 70;
    }
    .badge-code {
        font-weight: 700;
        color: #38BDF8;
    }
    .callout-badge.bound .badge-code {
        color: #A7F3D0;
    }
    .badge-bound-name {
        font-size: 0.68rem;
        font-weight: 600;
        color: #FFF;
        max-width: 110px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .hotspot-preview-badge {
        padding: 6px 12px;
        background: rgba(11, 15, 25, 0.9);
        border: 1px solid #FFD700;
        border-radius: 6px;
    }
    @@keyframes pulse-gold {
        0% { box-shadow: 0 0 10px #FFD700, 0 0 20px rgba(255, 215, 0, 0.4); }
        50% { box-shadow: 0 0 22px #FFD700, 0 0 40px rgba(255, 215, 0, 0.8); }
        100% { box-shadow: 0 0 10px #FFD700, 0 0 20px rgba(255, 215, 0, 0.4); }
    }
    @@keyframes pulse-live {
        0% { box-shadow: 0 0 5px rgba(245, 158, 11, 0.4); }
        50% { box-shadow: 0 0 16px rgba(245, 158, 11, 0.8); }
        100% { box-shadow: 0 0 5px rgba(245, 158, 11, 0.4); }
    }
</style>

@code {
    [Parameter]
    public ControllerLayoutDefinition Layout { get; set; } = new();

    [Parameter]
    public IReadOnlyList<ControllerMappingItem> Mappings { get; set; } = Array.Empty<ControllerMappingItem>();

    [Parameter]
    public int StickSlot { get; set; } = 1;

    [Parameter]
    public string? ActivePhysicalInput { get; set; }

    [Parameter]
    public EventCallback<(ControllerHotspot Hotspot, ControllerMappingItem? BoundItem)> OnHotspotSelected { get; set; }

    [Parameter]
    public EventCallback<ControllerMappingItem> OnClearBinding { get; set; }

    private int _selectedSubModuleIndex = 0;
    private string? _selectedHotspotId = null;
    private ControllerHotspot? _selectedHotspot = null;
    private string? _lastHandledInput = null;

    private IEnumerable<ControllerHotspot> GetAllHotspots() {
        if (Layout.SubModules == null || Layout.SubModules.Count == 0) {
            return Layout.Hotspots;
        }
        return Layout.Hotspots.Concat(Layout.SubModules.SelectMany(m => m.Hotspots));
    }

    protected override void OnParametersSet() {
        if (!string.IsNullOrWhiteSpace(ActivePhysicalInput) && ActivePhysicalInput != _lastHandledInput) {
            _lastHandledInput = ActivePhysicalInput;
            var activeSpot = GetAllHotspots().FirstOrDefault(h =>
                string.Equals(h.InputCode, ActivePhysicalInput, StringComparison.OrdinalIgnoreCase));
            if (activeSpot != null) {
                _selectedHotspotId = activeSpot.Id;
                _selectedHotspot = activeSpot;

                // Auto-switch to submodule tab ONLY when a NEW physical input is received
                if (activeSpot.ModuleName.Contains("SEM", StringComparison.OrdinalIgnoreCase)) {
                    _selectedSubModuleIndex = 1;
                } else if (activeSpot.ModuleName.Contains("FSM", StringComparison.OrdinalIgnoreCase)) {
                    _selectedSubModuleIndex = 2;
                } else if (_selectedSubModuleIndex > 0 && activeSpot.ModuleName.Contains("Grip", StringComparison.OrdinalIgnoreCase)) {
                    _selectedSubModuleIndex = 0;
                }
            }
        } else if (string.IsNullOrWhiteSpace(ActivePhysicalInput)) {
            _lastHandledInput = null;
        }
    }

    private void SelectSubModule(int index) {
        _selectedSubModuleIndex = index;
        _selectedHotspot = null;
        _selectedHotspotId = null;
    }

    private ControllerLayoutDefinition GetActiveLayout() {
        if (_selectedSubModuleIndex == 0 || Layout.SubModules.Count == 0) {
            return Layout;
        }

        var subIdx = _selectedSubModuleIndex - 1;
        if (subIdx >= 0 && subIdx < Layout.SubModules.Count) {
            return Layout.SubModules[subIdx];
        }

        return Layout;
    }

    private ControllerMappingItem? FindBoundItem(string inputCode) {
        if (Mappings.Count == 0 || string.IsNullOrWhiteSpace(inputCode)) {
            return null;
        }

        var cleanInput = inputCode.Trim().ToLowerInvariant();
        return Mappings.FirstOrDefault(m => {
            if (m.StickInstance != StickSlot) {
                return false;
            }

            var mCode = m.InputCode.ToLowerInvariant();
            if (mCode == cleanInput) {
                return true;
            }

            // Strip device prefix (e.g. js1_button1 -> button1, kb1_w -> w, mo1_mouse1 -> mouse1, gp1_button_a -> button_a)
            var uIdx = mCode.IndexOf('_');
            if (uIdx >= 0) {
                var unprefixed = mCode[(uIdx + 1)..];
                if (unprefixed == cleanInput) {
                    return true;
                }
            }

            return false;
        });
    }

    private string FormatDisplayButtonNumber(string inputCode) {
        var lower = inputCode.ToLowerInvariant();
        if (lower.StartsWith("button")) {
            return $"B{lower.Replace("button", "")}";
        }
        if (lower.StartsWith("mouse")) {
            return $"M{lower.Replace("mouse", "")}";
        }
        if (lower.StartsWith("slider")) {
            return "SLIDER";
        }
        if (lower == "space") return "SPC";
        if (lower == "backspace") return "BKSP";
        if (lower == "printscreen") return "PRT";
        if (lower == "scrolllock") return "SCR";
        if (lower == "pageup") return "PGUP";
        if (lower == "pagedown") return "PGDN";
        if (lower == "capslock") return "CAPS";
        if (lower.StartsWith("np_")) {
            return $"N{lower.Replace("np_", "").ToUpperInvariant()}";
        }
        return inputCode.ToUpperInvariant();
    }

    private string GetTooltipText(ControllerHotspot spot, ControllerMappingItem? boundItem) {
        if (boundItem != null) {
            return $"{spot.Label} ({spot.InputCode})\n→ BOUND TO: {boundItem.DisplayCategory} > {boundItem.DisplayAction}";
        }
        return $"{spot.Label} ({spot.InputCode})\n[Unmapped - Click to Assign]";
    }

    private void OnBadgeClicked(ControllerHotspot spot, ControllerMappingItem? boundItem) {
        _selectedHotspotId = spot.Id;
        _selectedHotspot = spot;
    }

    private async Task RebindSelectedAsync(ControllerHotspot spot, ControllerMappingItem? boundItem) {
        if (OnHotspotSelected.HasDelegate) {
            await OnHotspotSelected.InvokeAsync((spot, boundItem));
        }
    }

    private async Task ClearSelectedBindingAsync(ControllerMappingItem boundItem) {
        if (OnClearBinding.HasDelegate) {
            await OnClearBinding.InvokeAsync(boundItem);
        }
    }
}
