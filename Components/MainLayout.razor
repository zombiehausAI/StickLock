@inherits LayoutComponentBase
@inject IActionMapsXmlService XmlService
@inject IAppConfigService ConfigService
@inject IDirectInputService DirectInputService
@inject IUsbWatcherService UsbWatcher
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrowserService BrowserService
@inject IUpdateService UpdateService
@inject StickLock.Plugins.IGamePluginManager PluginManager

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="3" Dense="false" Class="px-4" Style="border-bottom: 1px solid rgba(0, 229, 255, 0.2); background: #0B0F19;">
        <img src="icon.png" alt="StickLock" style="width: 38px; height: 38px; border-radius: 8px; filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.35));" class="mr-3" />
        <div>
            <MudText Typo="Typo.h6" Class="mfd-title glow-cyan" Style="color: #00E5FF; line-height: 1.1;">STICKLOCK</MudText>
            <MudText Typo="Typo.caption" Class="mfd-code" Style="color: #94A3B8; letter-spacing: 1px;">@(PluginManager.ActivePlugin.Name.ToUpperInvariant()) CONTROLLER SYNC</MudText>
        </div>

        <!-- Game Profile Switcher -->
        <MudMenu Dense="true" Class="ml-4" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown"
                           Class="mfd-title"
                           Style="color: #00E5FF; border-color: rgba(0, 229, 255, 0.4); background: rgba(0, 229, 255, 0.05); font-weight: 700; font-size: 0.8rem;">
                    <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small" Class="mr-1" />
                    @(PluginManager.ActivePlugin.Name.ToUpperInvariant())
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @foreach (var plugin in PluginManager.AvailablePlugins) {
                    <MudMenuItem OnClick="@(() => OnGamePluginSelected(plugin.Id))"
                                 Style="@(plugin.Id == PluginManager.ActivePlugin.Id ? "background: rgba(0, 229, 255, 0.15); color: #00E5FF; font-weight: bold;" : "")">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@(plugin.Id == "starcitizen" ? Icons.Material.Filled.RocketLaunch : Icons.Material.Filled.Explore)" Size="Size.Small" Color="@(plugin.Id == PluginManager.ActivePlugin.Id ? Color.Primary : Color.Default)" />
                            <span>@plugin.Name</span>
                        </div>
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>

        <MudSpacer />

        <!-- Update Available Banner Button -->
        @if (_updateInfo?.IsUpdateAvailable == true) {
            <MudTooltip Text="Click to view update details and install">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SystemUpdate"
                           OnClick="OpenUpdateDialogAsync"
                           Class="mr-3 mfd-title"
                           Style="color: #0B0F19; font-weight: 700; background-color: #10B981; box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);">
                    v@(_updateInfo.LatestVersion) UPDATE
                </MudButton>
            </MudTooltip>
        }

        <!-- Ko-fi Support Button -->
        <MudTooltip Text="Support Developer on Ko-fi">
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Coffee"
                       OnClick="OpenKofi"
                       Class="mr-3 mfd-title"
                       Style="color: #FF5E5B; border-color: rgba(255, 94, 91, 0.5); font-weight: 700; background: rgba(255, 94, 91, 0.05);">
                Support
            </MudButton>
        </MudTooltip>

        <!-- About & Disclaimers Button -->
        <MudTooltip Text="About & Project Disclaimers">
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           OnClick="OpenAboutDialogAsync"
                           Class="mr-3" />
        </MudTooltip>

        <!-- Status Chip -->
        <MudChip T="string" Color="@GetStatusColor()" Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 font-weight-bold" Icon="@GetStatusIcon()">
            @GetStatusText()
        </MudChip>

        <!-- Prominent Sync Now Button -->
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@_isSyncing"
                   OnClick="OnSyncClickedAsync"
                   Class="mfd-title"
                   Style="font-weight: 700; letter-spacing: 1px; color: #0B0F19; background-color: #00E5FF;">
            @if (_isSyncing) {
                <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true" />
                <span>SYNCING...</span>
            } else {
                <span>SYNC NOW</span>
            }
        </MudButton>
    </MudAppBar>

    <MudMainContent Style="background-color: #0B0F19; height: 100vh; overflow-y: auto; padding-top: 80px; padding-left: 16px; padding-right: 16px; padding-bottom: 16px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = StickLockTheme.CreateTheme();
    private SyncStatus _status = SyncStatus.Unknown;
    private bool _isSyncing = false;
    private AppUpdateInfo? _updateInfo;

    protected override async Task OnInitializedAsync() {
        ConfigService.ConfigChanged += OnStateChanged;
        DirectInputService.DevicesRefreshed += _ => OnStateChanged();
        UsbWatcher.UsbDevicesChanged += _ => OnStateChanged();
        PluginManager.ActivePluginChanged += _ => OnStateChanged();

        await RefreshStatusAsync();

        _ = Task.Run(async () => {
            try {
                _updateInfo = await UpdateService.CheckForUpdateAsync();
                if (_updateInfo?.IsUpdateAvailable == true) {
                    await InvokeAsync(StateHasChanged);
                }
            } catch { }
        });
    }

    private void OnStateChanged() {
        _ = InvokeAsync(async () => {
            await RefreshStatusAsync();
            StateHasChanged();
        });
    }

    private async Task OnGamePluginSelected(string pluginId) {
        await PluginManager.SetActivePluginAsync(pluginId);
        Snackbar.Add($"Switched active flight profile to {PluginManager.ActivePlugin.Name}.", Severity.Info);
        await RefreshStatusAsync();
        StateHasChanged();
    }

    private async Task RefreshStatusAsync() {
        try {
            var check = await PluginManager.ActivePlugin.CheckAlignmentAsync();
            _status = check.Status;
        } catch {
            _status = SyncStatus.Error;
        }
    }

    private async Task OnSyncClickedAsync() {
        if (_isSyncing) {
            return;
        }

        _isSyncing = true;
        StateHasChanged();

        try {
            var result = await PluginManager.ActivePlugin.SyncAsync();
            if (result.Success) {
                if (result.ChangesMade) {
                    Snackbar.Add(result.Message, Severity.Success);
                } else {
                    Snackbar.Add(result.Message, Severity.Info);
                }
            } else {
                Snackbar.Add(result.Message, Severity.Warning);
            }
            await RefreshStatusAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        } finally {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private Color GetStatusColor() => _status switch {
        SyncStatus.Aligned => Color.Success,
        SyncStatus.NeedsSync => Color.Warning,
        SyncStatus.SticksDisconnected => Color.Error,
        SyncStatus.StarCitizenActive => Color.Info,
        SyncStatus.FileNotFound => Color.Error,
        _ => Color.Dark
    };

    private string GetStatusIcon() => _status switch {
        SyncStatus.Aligned => Icons.Material.Filled.CheckCircle,
        SyncStatus.NeedsSync => Icons.Material.Filled.WarningAmber,
        SyncStatus.SticksDisconnected => Icons.Material.Filled.UsbOff,
        SyncStatus.StarCitizenActive => Icons.Material.Filled.SportsEsports,
        SyncStatus.FileNotFound => Icons.Material.Filled.FolderOff,
        _ => Icons.Material.Filled.HelpOutline
    };

    private string GetStatusText() => _status switch {
        SyncStatus.Aligned => "ALIGNED",
        SyncStatus.NeedsSync => "ORDER FLIPPED - NEEDS SYNC",
        SyncStatus.SticksDisconnected => "STICKS DISCONNECTED",
        SyncStatus.StarCitizenActive => "STAR CITIZEN ACTIVE",
        SyncStatus.FileNotFound => "XML NOT FOUND",
        _ => "SETUP REQUIRED"
    };

    private void OpenKofi() {
        BrowserService.OpenUrl("https://ko-fi.com/zombiehaus");
    }

    private async Task OpenAboutDialogAsync() {
        var options = new DialogOptions {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        await DialogService.ShowAsync<AboutDialog>("About StickLock & Project Disclaimers", options);
    }

    private async Task OpenUpdateDialogAsync() {
        if (_updateInfo == null) {
            return;
        }

        var parameters = new DialogParameters<UpdateDialog> {
            { x => x.UpdateInfo, _updateInfo }
        };
        var options = new DialogOptions {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        await DialogService.ShowAsync<UpdateDialog>("StickLock Update Available", parameters, options);
    }

    public void Dispose() {
        ConfigService.ConfigChanged -= OnStateChanged;
        PluginManager.ActivePluginChanged -= _ => OnStateChanged();
    }
}

